# Copy to .env and fill in. NEVER commit .env.
APP_ENV=production            # development | staging | production
APP_URL=https://www.bkenfab.com
FORCE_HTTPS=true              # also enables HSTS; set only after HTTPS works
COOKIE_SECURE=true
ENCRYPTION_KEY=               # generate: php -r "echo bin2hex(random_bytes(32));"
PROXY_IPS=                    # load balancer IPs, comma separated, if any

DB_HOST=localhost
DB_PORT=3306
DB_NAME=bkenfab
DB_USER=bkenfab
DB_PASS=

SMTP_PASS=                    # SMTP host/user/port are set in Admin > Settings > Email
RECAPTCHA_SECRET=             # optional; site key goes in Admin > Settings > Forms
